BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=your_telegram_user_id_here

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TEMPERATURE=0.7

