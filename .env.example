BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=your_telegram_user_id_here

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.7

DATABASE_PATH=./data/bot.db

FREE_DAILY_LIMIT=30
MAX_FILE_SIZE_MB=20

TEMP_DIR=./temp
UPLOADS_DIR=./uploads
DOWNLOADS_DIR=./downloads
DATA_DIR=./data
LOGS_DIR=./logs
LOG_LEVEL=INFO

# Google Sheets Real-Time Activity Logging
# Google Apps Script Web App URL (Deploy -> New deployment -> Web app -> Anyone)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec
# Ixtiyoriy: Google Sheet to'liq havolasi (admin tugmasi orqali oson kirish uchun)
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/.../edit
